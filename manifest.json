{
  "manifest_version": 3,
  "name": "Smart Exam Assistant",
  "version": "1.0",
  "description": "AI-powered assistant for study.nsu.edu.cn",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://study.nsu.edu.cn/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://dashscope.aliyuncs.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Exam Assistant Settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://study.nsu.edu.cn/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
