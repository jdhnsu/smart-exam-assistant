{
  "manifest_version": 3,
  "name": "Smart Exam Assistant",
  "version": "1.0",
  "description": "AI-powered assistant for study.nsu.edu.cn",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://study.nsu.edu.cn/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.deepseek.com/*",
    "https://open.bigmodel.cn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Exam Assistant Settings"
  },
  "background": {
    "service_worker": "background/index.js"
  },
  "content_scripts": [
    {
      "matches": ["https://study.nsu.edu.cn/*"],
      "js": [
        "shared/constants.js",
        "shared/utils.js",
        "content/extractor.js",
        "content/applicator.js",
        "content/ui.js",
        "content/auto-mode.js",
        "content/navigator.js",
        "content/assistant.js",
        "content/box-select.js",
        "content/index.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
